rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User prefs (plan + aiUsage are server-managed) ──
    match /users/{userId}/prefs/current {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Authenticated user can write their prefs, BUT cannot modify plan, aiUsage, or stripeCustomerId
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['plan', 'aiUsage', 'stripeCustomerId']);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'aiUsage', 'stripeCustomerId']);
      // Unauthenticated server updates (ai.js counter, Stripe webhook, verify-checkout)
      // can ONLY modify plan, aiUsage, and stripeCustomerId
      allow update: if request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'aiUsage', 'stripeCustomerId']);
    }

    // ── Songs ──
    match /users/{userId}/songs/{songId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Voice profiles ──
    match /users/{userId}/profiles/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Scratch pad ──
    match /users/{userId}/scratch/{songId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Feedback: authenticated users can create, nobody reads from client ──
    match /feedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.user.uid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
